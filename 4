local function AddCard(pageName, title, description)
    local page = Pages[pageName]

    local Card = Make("Frame", {
        Size = UDim2.fromOffset(280,100),
        BackgroundColor3 = Color3.fromRGB(21,21,26),
        BorderSizePixel = 0
    }, page)

    Corner(Card, 9)
    Line(Card)

    Text(Card, title, 14,
        Color3.fromRGB(235,235,240)
    ).Position = UDim2.fromOffset(15,12)

    local desc = Text(Card, description, 11,
        Color3.fromRGB(125,125,135)
    )

    desc.Position = UDim2.fromOffset(15,36)
    desc.Size = UDim2.new(1,-30,0,35)
    desc.TextWrapped = true
    desc.TextYAlignment = Enum.TextYAlignment.Top

    local Toggle = Make("TextButton", {
        Size = UDim2.fromOffset(38,21),
        Position = UDim2.new(1,-53,1,-31),
        BackgroundColor3 = Color3.fromRGB(45,45,52),
        Text = "",
        AutoButtonColor = false
    }, Card)

    Corner(Toggle, 12)

    local Dot = Make("Frame", {
        Size = UDim2.fromOffset(15,15),
        Position = UDim2.fromOffset(3,3),
        BackgroundColor3 = Color3.fromRGB(155,155,160),
        BorderSizePixel = 0
    }, Toggle)

    Corner(Dot, 10)

    local enabled = false

    Toggle.MouseButton1Click:Connect(function()
        enabled = not enabled

        TweenService:Create(Toggle,TweenInfo.new(.15),{
            BackgroundColor3 = enabled
                and Color3.fromRGB(55,125,225)
                or Color3.fromRGB(45,45,52)
        }):Play()

        TweenService:Create(Dot,TweenInfo.new(.15),{
            Position = enabled
                and UDim2.fromOffset(20,3)
                or UDim2.fromOffset(3,3)
        }):Play()
    end)
end

