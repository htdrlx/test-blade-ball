local function MakePage(name)
    local page = New("ScrollingFrame", {
        Size = UDim2.fromScale(1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Color3.fromRGB(80,80,90),
        CanvasSize = UDim2.new(0,0,0,0),
        Visible = false
    }, Content)

    New("UIGridLayout", {
        CellSize = UDim2.fromOffset(265,92),
        CellPadding = UDim2.fromOffset(10,10),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, page)

    Pages[name] = page
    return page
end

for _,name in ipairs(categories) do
    local page = MakePage(name)

    local b = New("TextButton", {
        Size = UDim2.new(1,0,0,36),
        Text = "   "..name,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Color3.fromRGB(155,155,165),
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundColor3 = Color3.fromRGB(15,15,18),
        AutoButtonColor = false,
        LayoutOrder = table.find(categories,name)
    }, Side)

    Corner(b,7)
    Buttons[name] = b

    b.MouseEnter:Connect(function()
        if not page.Visible then
            TweenService:Create(b,TweenInfo.new(.12),{
                BackgroundColor3 = Color3.fromRGB(23,23,28)
            }):Play()
        end
    end)

    b.MouseLeave:Connect(function()
        if not page.Visible then
            TweenService:Create(b,TweenInfo.new(.12),{
                BackgroundColor3 = Color3.fromRGB(15,15,18)
            }):Play()
        end
    end)

    b.MouseButton1Click:Connect(function()
        for n,p in pairs(Pages) do
            p.Visible = n == name
            Buttons[n].BackgroundColor3 =
                n == name and Color3.fromRGB(35,35,42)
                or Color3.fromRGB(15,15,18)

            Buttons[n].TextColor3 =
                n == name and Color3.fromRGB(235,235,240)
                or Color3.fromRGB(155,155,165)
        end
    end)
end

local function AddToggle(pageName, title, desc)
    local page = Pages[pageName]

    local card = New("Frame", {
        BackgroundColor3 = Color3.fromRGB(22,22,27),
        BorderSizePixel = 0
    }, page)
    Corner(card,8)
    Stroke(card,0.5)

    local t = Label(title,14,Color3.fromRGB(235,235,240),card)
    t.Position = UDim2.fromOffset(14,12)
    t.Size = UDim2.new(1,-65,0,20)

    local d = Label(desc or "",11,Color3.fromRGB(125,125,135),card)
    d.Position = UDim2.fromOffset(14,34)
    d.Size = UDim2.new(1,-25,0,28)
    d.TextWrapped = true

    local toggle = New("TextButton", {
        Size = UDim2.fromOffset(36,20),
        Position = UDim2.new(1,-50,0,13),
        Text = "",
        BackgroundColor3 = Color3.fromRGB(45,45,52),
        AutoButtonColor = false
    }, card)
    Corner(toggle,10)

    local dot = New("Frame", {
        Size = UDim2.fromOffset(14,14),
        Position = UDim2.fromOffset(3,3),
        BackgroundColor3 = Color3.fromRGB(150,150,155),
        BorderSizePixel = 0
    }, toggle)
    Corner(dot,10)

    local enabled = false

    toggle.MouseButton1Click:Connect(function()
        enabled = not enabled

        TweenService:Create(toggle,TweenInfo.new(.15),{
            BackgroundColor3 = enabled
                and Color3.fromRGB(95,75,180)
                or Color3.fromRGB(45,45,52)
        }):Play()

        TweenService:Create(dot,TweenInfo.new(.15),{
            Position = enabled
                and UDim2.fromOffset(19,3)
                or UDim2.fromOffset(3,3)
        }):Play()
    end)

    return function()
        return enabled
    end
end

